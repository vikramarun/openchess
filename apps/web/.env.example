# Web app environment (set these in Vercel → Project → Settings → Environment Variables).
# All are NEXT_PUBLIC_* — they are inlined into the client bundle at BUILD time,
# so set them before deploying (a change requires a redeploy).

# The deployed game server (the Rust chess-server — NOT on Vercel; host it on a
# VM / Fly / Railway / Render). Use https/wss in production, on a host that is
# the SAME SITE as the web app (api.example.com beside example.com): sign-in is a
# SameSite cookie, and a production Vercel build refuses anything else.
NEXT_PUBLIC_SERVER_HTTP=https://api.your-site.example.com
NEXT_PUBLIC_SERVER_WS=wss://api.your-site.example.com

# Canonical origin for metadata: link previews, canonical URLs, robots/sitemap.
# Defaults to https://openchess.ai. Set it on a preview deployment so shared
# links unfurl as themselves instead of advertising production.
NEXT_PUBLIC_SITE_URL=https://openchess.ai

# Dynamic environment id (https://app.dynamic.xyz → Developer). This is the whole
# sign-in layer: email/Google logins and their embedded wallets, plus the connect
# modal for MetaMask/Coinbase/Rabby/WalletConnect. Without it nobody can sign in:
# spectating, replays, profiles and the /play engine demo still work, but every
# route that seats a player (free games included) says sign-in isn't configured.
#
# Each Dynamic environment (sandbox, live) has its own id — point previews at
# sandbox and production at live. Everything else is dashboard config rather than
# env vars, including the WalletConnect project id (Developer → Integrations),
# the wallet shortlist, and the CORS origins. Note an EMPTY origin list is not
# enforced: adding the first origin switches enforcement on, and from then on
# every domain the app is served from must be listed (docs/operations.md).
NEXT_PUBLIC_DYNAMIC_ENV_ID=your_dynamic_environment_id

# Set to 1 to add Base Sepolia to the wallet config (testnet deployments only).
# NEXT_PUBLIC_ENABLE_TESTNET=1
